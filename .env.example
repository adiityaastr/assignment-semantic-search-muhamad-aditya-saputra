# ============================================================
# Konfigurasi environment - Semantic Search & LLM Application
# ============================================================
# Cara pakai:
#   1. Salin file ini menjadi .env di folder yang sama (root project):
#        Windows (PowerShell) : Copy-Item .env.example .env
#        macOS / Linux        : cp .env.example .env
#   2. Ganti nilai GEMINI_API_KEY dengan API key Anda.
#   3. Jangan upload file .env ke GitHub (sudah dikecualikan di .gitignore).

# [WAJIB] API key Gemini - buat gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# [OPSIONAL] Model yang digunakan. Biarkan default kecuali model tidak tersedia di akun Anda.
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-flash-lite-latest
